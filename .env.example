# Copy this file to `.env.local` and fill in your token.
# `.env.local` is git-ignored. The Vite dev server adds the token to requests it
# forwards to api.github.com (/gh/*), so the token is never sent to the browser.

# GitHub token with read access to Projects (classic PAT: `read:project` + `repo`;
# fine-grained: Organization > Projects: Read, plus Issues/Pull requests read).
# If the org uses SSO: Configure SSO → Authorize the token for the org.
FLOW_GITHUB_TOKEN=

# Organization shown by default on the connect screen
GITHUB_OWNER=Solution-Dev3

# Project, product, release month and field mapping are chosen in the app
# (step 2) and remembered in the browser per project.
